  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "npm run prisma:generate && npm run swagger && tsc && tsc-alias && node scripts/copy-swagger.cjs",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "start": "node dist/src/main/server.js",
    "swagger": "tsx src/main/config/swagger-generator.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:integration": "npm run build && node --test tests/stage2.integration.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
