    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "prisma": "^6.12.0",
    "swagger-autogen": "^2.23.7",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "axios": "^1.20.0",
    "dotenv": "^18.0.7",
