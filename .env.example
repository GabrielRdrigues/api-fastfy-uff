# API: porta acessível no computador e dentro do container
PORT=3333
NODE_ENV=development

# pgAdmin Desktop e API executada no Windows conectam em localhost:5433.
# O PostgreSQL já instalado no Windows pode continuar em 5432.
# Dentro do Compose a API usa postgres:5432 automaticamente.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=manager-api
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=pokemon-manager

# true usa a PokéAPI; false usa o gateway em memória para modo offline/testes.
USE_EXTERNAL_API=true

# Interfaces opcionais: docker compose --profile tools up -d
ADMINER_PORT=8080
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@pokemon.local
PGADMIN_PASSWORD=admin1234

# Prisma CLI usa esta URL quando executado no computador.
DATABASE_URL=postgresql://manager-api:troque_esta_senha@localhost:5433/pokemon-manager?schema=public
